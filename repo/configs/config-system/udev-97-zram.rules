# When zram is active, swapping to zram beats evicting page cache: zram pages
# are just compressed, while cache evictions trigger expensive disk reads. Bump
# swappiness above the conservative static default in 99-desktop.conf (100) only
# once zram is confirmed up, and disable zswap so it doesn't double-compress
# zram pages. If zram ever fails to activate, the static default stays low
# instead of aggressively swapping to real disk.
ACTION=="change", KERNEL=="zram0", ATTR{initstate}=="1", SYSCTL{vm.swappiness}="150", \
    RUN+="/bin/sh -c 'echo N > /sys/module/zswap/parameters/enabled'"