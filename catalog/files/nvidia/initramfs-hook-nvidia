#!/bin/sh
# Managed by debforge (nvidia). Loads the NVIDIA driver from the initramfs,
# so it is ready before the display manager starts.
PREREQ=""
prereqs() { echo "$PREREQ"; }
case "$1" in prereqs) prereqs; exit 0 ;; esac
. /usr/share/initramfs-tools/hook-functions
# Kernels the driver isn't built for (DKMS) are left as they are.
modinfo -k "${version}" nvidia_drm >/dev/null 2>&1 || exit 0
force_load nvidia_drm
