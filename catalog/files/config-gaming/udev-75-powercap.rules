# MangoHud and powertop read CPU power without root. Video group only: a
# world-readable energy_uj is the PLATYPUS side channel (CVE-2020-8694).
ENV{SUBSYSTEM}=="powercap", ACTION=="add|change", RUN+="/usr/bin/find /sys$env{DEVPATH} -name energy_uj -exec chmod 440 {} + -exec chown root:video {} +"
