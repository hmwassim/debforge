# Disable snd_hda_intel power saving on AC (avoids pops and cracks) and
# restore the kernel default on battery. Desktops count as always on AC.

ACTION=="add|change", SUBSYSTEM=="sound", KERNEL=="card*", DRIVERS=="snd_hda_intel", \
    TEST!="/run/udev/snd-hda-intel-powersave", \
    RUN+="/usr/local/lib/debforge/audio-pm-ctl init"

ACTION=="add|change", SUBSYSTEM=="power_supply", ENV{POWER_SUPPLY_TYPE}=="Mains", ENV{POWER_SUPPLY_ONLINE}=="0", \
    TEST=="/sys/module/snd_hda_intel", \
    RUN+="/usr/local/lib/debforge/audio-pm-ctl battery"

ACTION=="add|change", SUBSYSTEM=="power_supply", ENV{POWER_SUPPLY_TYPE}=="Mains", ENV{POWER_SUPPLY_ONLINE}=="1", \
    TEST=="/sys/module/snd_hda_intel", \
    RUN+="/usr/local/lib/debforge/audio-pm-ctl ac"
