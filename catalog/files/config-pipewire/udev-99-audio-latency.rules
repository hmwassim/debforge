# Low-latency audio (CachyOS 40-hpet-permissions + 99-cpu-dma-latency):
# members of the audio group may use the RTC/HPET timers and request CPU
# DMA latency limits. config-pipewire adds the user to the audio group.
KERNEL=="rtc0", GROUP="audio"
KERNEL=="hpet", GROUP="audio"

DEVPATH=="/devices/virtual/misc/cpu_dma_latency", OWNER="root", GROUP="audio", MODE="0660"
