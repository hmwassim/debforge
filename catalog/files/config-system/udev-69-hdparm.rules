# Desktops only, internal rotational HDDs: -B 254 is the highest APM level
# (best performance, no APM spin-down), which stops aggressive head parking
# (constant load/unload cycles); -S 0 disables the spin-down timer.
#
# Two pitfalls this rule avoids:
#   - Matching on ATTRS{id/bus}=="ata" never matches anything, so such a
#     rule is silently a no-op; ENV{ID_BUS} is the property that works.
#   - ENV{ID_BUS}=="ata" alone also matches USB-bridged SSDs that report
#     rotational=1 over the uas driver, and hdparm then blocks udev for
#     about 21s on them. ENV{ID_USB_DRIVER}=="" excludes anything attached
#     through a USB storage driver.
ACTION=="add|change", KERNEL=="sd[a-z]", ATTR{queue/rotational}=="1", \
    ENV{ID_BUS}=="ata", ENV{ID_USB_DRIVER}=="", RUN+="/usr/sbin/hdparm -B 254 -S 0 /dev/%k"
