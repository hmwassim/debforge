# Storage: keep SATA links at full power. Desktops only: it removes link
# wake-up latency at the cost of a little idle power.
ACTION=="add|change", SUBSYSTEM=="scsi_host", KERNEL=="host*", \
    ATTR{link_power_management_supported}=="1", \
    ATTR{link_power_management_policy}=="*", \
    ATTR{link_power_management_policy}="max_performance"
