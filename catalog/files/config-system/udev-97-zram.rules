# When zram is active, swapping to zram beats evicting page cache: zram pages
# are just compressed, while cache evictions trigger expensive disk reads. Once
# zram0 is initialised, raise swappiness from the static 99-debforge.conf value
# (100) to 150 and disable zswap so it doesn't double-compress zram pages.
ACTION=="change", KERNEL=="zram0", ATTR{initstate}=="1", SYSCTL{vm.swappiness}="150", \
    RUN+="/bin/sh -c 'echo N > /sys/module/zswap/parameters/enabled'"
